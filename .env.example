# Optional: Supabase PostgreSQL (Production Cloud Storage)
# If not provided, the app will use local JSON store for local development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key

# Optional: Security Secret for /api/cron endpoint
# When set, external schedulers must pass: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_custom_secure_cron_secret_here
